{
  "name": "@zephor/dsh-fixup-patches",
  "version": "0.1.2",
  "description": "Per-profile patches for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zephor5/dsh-plugins.git",
    "directory": "fixup-patches"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./reuse-loaded-skills": "./patches/reuse-loaded-skills/index.js",
    "./reuse-loaded-skills/locale/*.json": "./patches/reuse-loaded-skills/locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "locale",
    "patches"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
